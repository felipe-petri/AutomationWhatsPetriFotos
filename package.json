    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
